{
  "compilerOptions": {
    // 环境设置
    "module": "es2022",
    "target": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext"
    ],
    "types": [
      "node"
    ],
    // 只做类型检查，不输出文件
    "noEmit": true,
    // 因为 include 包含 src 外的文件，rootDir 不能写 ./src，否则会报 TS6059
    // 直接删掉 rootDir，或设为 "."
    // "rootDir": ".",
    // 严格检查（保持你原来的）
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}