{
	"$schema": "../../src/config/schema.json",
	"controls": [
		{
			"type": "input",
			"id": "command",
			"label": "绑定功能指令",
			"default": "bind",
			"desc": "设定绑定功能的指令"
		},
		{
			"type": "slider",
			"id": "duration",
			"label": "绑定令牌有效时长",
			"default": 300000,
			"max": 1800000,
			"min": 30000,
			"step": 100,
			"desc": "已签发的令牌有效期不会改变, 只影响新令牌"
		},
		{
			"type": "group",
			"id": "danger",
			"label": "危险功能",
			"controls": [{
				"type": "switch",
				"id": "allowGroup",
				"label": "允许群聊/频道场景获取绑定令牌",
				"default": false,
				"desc": "注意: 开启此项后将允许用户在不安全的多人会话中获取绑定令牌, 可能导致他人冒充或共享用户数据"
			}]
		}
	]
}