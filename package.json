{
  "name": "chirucat",
  "version": "0.1.0-alpha",
  "description": "采用Core + Adapter架构的聊天机器人框架",
  "keywords": [
    "bot",
    "chirucat"
  ],
  "license": "MIT",
  "author": "9halfcirno",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "app": "tsx src/app.ts",
    "webui": "tsx src/webui/server/server.ts",
    "check:state": "tsx scripts/check-bot-state.ts",
    "check:services": "tsx scripts/check-services.ts",
    "check:service-state": "tsx scripts/check-service-state.ts",
    "check:core": "tsx scripts/check-core-boot.ts",
    "check:core-api": "tsx scripts/check-core-api.ts",
    "check:settings": "tsx scripts/check-settings.ts && tsx scripts/check-settings-api.ts",
    "check:types": "tsc -p tsconfig.check.json --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.4"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "json5": "^2.2.3",
    "smol-toml": "^1.7.1",
    "ws": "^8.21.3"
  }
}
