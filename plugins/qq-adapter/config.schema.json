{
	"$schema": "../../src/config/schema.json",
	"controls": [
		{
			"type": "input",
			"id": "app_id",
			"label": "机器人 AppID",
			"required": true
		},
		{
			"type": "input",
			"id": "secret",
			"label": "机器人密钥",
			"desc": "即QQBot管理页面的secret, 注意管理平台的密钥只能查看一遍",
			"required": true,
			"attr": {
				"type": "password"
			}
		},
		{
			"type": "slider",
			"id": "reply_interval",
			"label": "会话回复间隔 (ms)",
			"desc": "同一会话两次发送之间的最小间隔, 0 表示不限制",
			"min": 0,
			"max": 5000,
			"step": 100,
			"default": 0
		}
	]
}